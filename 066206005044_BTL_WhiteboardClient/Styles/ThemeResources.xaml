<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#11161F" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1A212E" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#202A39" />
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#0E141D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#37D67A" />
    <SolidColorBrush x:Key="StrongTextBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A6B5C8" />
    <SolidColorBrush x:Key="BorderBrushToken" Color="#2C3A4E" />

    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushToken}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0C151F" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ListSurfaceStyle" TargetType="ListView">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="#182230" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushToken}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
    </Style>
</ResourceDictionary>
