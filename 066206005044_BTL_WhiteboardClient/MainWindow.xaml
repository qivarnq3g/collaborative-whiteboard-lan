<Window
    x:Class="Btl.Whiteboard.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BTL - Collaborative Whiteboard">

    <Grid
        Padding="12"
                    PointerCaptureLost="CanvasHost_PointerCaptureLost"
        ColumnSpacing="12"
        KeyDown="MainWindow_KeyDown"
        KeyUp="MainWindow_KeyUp"
        Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            BorderThickness="1"
            Padding="8"
            CornerRadius="8"
            Background="{ThemeResource PanelBackgroundBrush}"
            BorderBrush="{ThemeResource PanelStrokeBrush}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="ConnectionBadgeBorder" BorderThickness="1" Padding="6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="ConnectionStateDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionBadgeTextBlock" Text="Disconnected" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Theme" Width="60" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="ThemeComboBox" Width="180" SelectionChanged="ThemeComboBox_SelectionChanged" ToolTipService.ToolTip="App color theme">
                        <ComboBoxItem Content="Auto" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Name" Width="60" VerticalAlignment="Center" FontSize="12" />
                    <TextBox x:Name="UserNameTextBox" Width="180" PlaceholderText="Your name" LostFocus="UserNameTextBox_LostFocus" KeyDown="UserNameTextBox_KeyDown" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Password" Width="60" VerticalAlignment="Center" FontSize="12" />
                    <StackPanel Width="180" Spacing="3">
                        <PasswordBox x:Name="RoomPasswordBox" PlaceholderText="Optional (required if locked)" PasswordChanged="RoomPasswordBox_PasswordChanged" ToolTipService.ToolTip="Required only if the room is locked" />
                        <Button x:Name="SaveRoomPasswordButton" Content="Save Password" Click="SaveRoomPasswordButton_Click" Visibility="Collapsed" HorizontalAlignment="Left" FontSize="11" Padding="6,2" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RefreshRoomsButton" Content="Refresh" Click="RefreshRoomsButton_Click" ToolTipService.ToolTip="Scan for available rooms" />
                    <Button Grid.Column="1" x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" ToolTipService.ToolTip="Join the selected room (Enter)" />
                </Grid>

                <Grid Grid.Row="5" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Rooms" FontWeight="SemiBold" FontSize="12" />
                    <Grid Grid.Row="1">
                        <ListView x:Name="RoomListView" AutomationProperties.Name="Available rooms list" SelectionChanged="RoomListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{ThemeResource WarningBadgeBackgroundBrush}" Visibility="{Binding IsPasswordProtected, Converter={StaticResource BoolToVisibilityConverter}}" ToolTipService.ToolTip="Password protected" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding RoomName}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding ServerName}" Opacity="0.6" FontSize="10" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="RoomEmptyTextBlock" Text="No rooms. Start server." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="11" />
                    </Grid>
                </Grid>
                
                <TextBlock x:Name="ConnectionStatusTextBlock" Grid.Row="6" TextWrapping="Wrap" Opacity="0.75" FontSize="11" />
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            BorderThickness="1"
            CornerRadius="8"
            Background="{ThemeResource PanelBackgroundBrush}"
            BorderBrush="{ThemeResource PanelStrokeBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="6" Padding="8">
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Tools" FontWeight="SemiBold" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleButton x:Name="PencilToolToggleButton" Width="32" Padding="4" Click="ToolToggleButton_Click" ToolTipService.ToolTip="Pencil (P)">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED63;" FontSize="16" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="LineToolToggleButton" Width="32" Padding="4" Click="ToolToggleButton_Click" ToolTipService.ToolTip="Line (L)">
                                        <PathIcon Data="M 0,15 L 1,16 L 16,1 L 15,0 Z" Width="16" Height="16" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="RectangleToolToggleButton" Width="32" Padding="4" Click="ToolToggleButton_Click" ToolTipService.ToolTip="Rectangle (R)">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF407;" FontSize="16" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="EllipseToolToggleButton" Width="32" Padding="4" Click="ToolToggleButton_Click" ToolTipService.ToolTip="Ellipse (O)">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA3A;" FontSize="16" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="EraserToolToggleButton" Width="32" Padding="4" Click="ToolToggleButton_Click" ToolTipService.ToolTip="Eraser (E)">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE75C;" FontSize="16" />
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Size" FontWeight="SemiBold" FontSize="12" />
                                <NumberBox
                                    x:Name="StrokeThicknessNumberBox"
                                    Minimum="1" Maximum="100"
                                    SmallChange="1" LargeChange="5"
                                    SpinButtonPlacementMode="Compact"
                                    Width="95"
                                    ToolTipService.ToolTip="Brush size in pixels (1–100)"
                                    ValueChanged="StrokeThicknessNumberBox_ValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Color" FontWeight="SemiBold" FontSize="12" />
                                <StackPanel x:Name="ColorSwatchesPanel" Orientation="Horizontal" Spacing="4">
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#1F6FEB" Tag="#1F6FEB" Click="ColorSwatchButton_Click" ToolTipService.ToolTip="Blue (#1F6FEB)" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#10B981" Tag="#10B981" Click="ColorSwatchButton_Click" ToolTipService.ToolTip="Green (#10B981)" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#F97316" Tag="#F97316" Click="ColorSwatchButton_Click" ToolTipService.ToolTip="Orange (#F97316)" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#D946EF" Tag="#D946EF" Click="ColorSwatchButton_Click" ToolTipService.ToolTip="Magenta (#D946EF)" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#EF4444" Tag="#EF4444" Click="ColorSwatchButton_Click" ToolTipService.ToolTip="Red (#EF4444)" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#06B6D4" Tag="#06B6D4" Click="ColorSwatchButton_Click" ToolTipService.ToolTip="Cyan (#06B6D4)" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#111827" Tag="#111827" Click="ColorSwatchButton_Click" ToolTipService.ToolTip="Black (#111827)" />
                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="ColorSwatchButton_Click" ToolTipService.ToolTip="White (#FFFFFF)" />
                                </StackPanel>
                                <TextBlock Text="Recent" Opacity="0.8" />
                                <StackPanel x:Name="RecentColorSwatchesPanel" Orientation="Horizontal" Spacing="4" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox x:Name="StrokeColorComboBox" Width="120" SelectionChanged="StrokeColorComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Blue" Tag="#1F6FEB" />
                                        <ComboBoxItem Content="Green" Tag="#10B981" />
                                        <ComboBoxItem Content="Orange" Tag="#F97316" />
                                        <ComboBoxItem Content="Magenta" Tag="#D946EF" />
                                        <ComboBoxItem Content="Red" Tag="#EF4444" />
                                        <ComboBoxItem Content="Cyan" Tag="#06B6D4" />
                                        <ComboBoxItem Content="Black" Tag="#111827" />
                                        <ComboBoxItem Content="White" Tag="#FFFFFF" />
                                    </ComboBox>
                                    <TextBox x:Name="CustomColorTextBox" Width="100" PlaceholderText="#RRGGBB" KeyDown="CustomColorTextBox_KeyDown" ToolTipService.ToolTip="Enter a HEX color, e.g. #FF5733" />
                                    <Button x:Name="ApplyCustomColorButton" Content="Apply" Click="ApplyCustomColorButton_Click" ToolTipService.ToolTip="Apply custom color" />
                                    <Button x:Name="AdvancedColorPickerButton" Content="Picker" ToolTipService.ToolTip="Open color picker">
                                        <Button.Flyout>
                                            <Flyout x:Name="AdvancedColorPickerFlyout" Closed="AdvancedColorPickerFlyout_Closed" Placement="BottomEdgeAlignedLeft">
                                                <StackPanel Width="300" Spacing="8">
                                                    <TextBlock Text="Click or drag to pick a color" Opacity="0.8" />
                                                    <ColorPicker x:Name="AdvancedColorPicker" IsAlphaEnabled="False" ColorChanged="AdvancedColorPicker_ColorChanged" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4" Visibility="Collapsed">
                                <TextBlock Text="Layers" FontWeight="SemiBold" />
                                <ComboBox x:Name="ActiveLayerComboBox" Width="150" SelectionChanged="ActiveLayerComboBox_SelectionChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="AddLayerButton" Content="+ Layer" Click="AddLayerButton_Click" />
                                    <Button x:Name="ToggleLayerVisibilityButton" Content="Show/Hide" Click="ToggleLayerVisibilityButton_Click" />
                                    <Button x:Name="ToggleLayerLockButton" Content="Lock" Click="ToggleLayerLockButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentToolTextBlock" Text="Tool: Pencil" FontSize="11" />
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="UndoButton" Content="Undo" Click="UndoButton_Click" FontSize="11" Padding="8,4" ToolTipService.ToolTip="Undo (Ctrl+Z)" />
                        <Button Grid.Column="2" x:Name="RedoButton" Content="Redo" Click="RedoButton_Click" FontSize="11" Padding="8,4" ToolTipService.ToolTip="Redo (Ctrl+Y)" />

                        <Border Grid.Column="3" x:Name="CanvasConnectionBadgeBorder" BorderThickness="1" Padding="6" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse x:Name="CanvasConnectionStateDot" Width="8" Height="8" VerticalAlignment="Center" />
                                <TextBlock x:Name="CanvasConnectionTextBlock" Text="Disconnected" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>

                <Border
                    Grid.Row="1"
                    x:Name="CanvasHost"
                    Background="{ThemeResource CanvasBackgroundBrush}"
                    BorderBrush="{ThemeResource PanelStrokeBrush}"
                    BorderThickness="1"
                    PointerPressed="CanvasHost_PointerPressed"
                    PointerMoved="CanvasHost_PointerMoved"
                    PointerReleased="CanvasHost_PointerReleased"
                    PointerCanceled="CanvasHost_PointerCanceled"
                    PointerWheelChanged="CanvasHost_PointerWheelChanged">
                    <Grid x:Name="CanvasViewportGrid" SizeChanged="CanvasViewportGrid_SizeChanged">
                        <Canvas x:Name="DrawingCanvas" AutomationProperties.Name="Shared drawing canvas" />
                        <TextBlock x:Name="CanvasHintTextBlock" Text="Connect to a room to start drawing" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Column="2"
            BorderThickness="1"
            Padding="8"
            CornerRadius="8"
            Background="{ThemeResource PanelBackgroundBrush}"
            BorderBrush="{ThemeResource PanelStrokeBrush}">
            <TabView
                x:Name="RightPanelTabView"
                IsAddTabButtonVisible="False"
                SelectedIndex="0"
                TabWidthMode="Equal"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource PanelStrokeBrush}"
                ToolTipService.ToolTip="Layers (F1) • Users (F2) • Chat (F3)">
                <TabViewItem Header="Layers">
                    <Grid
                        RowSpacing="8"
                        Padding="6"
                        Background="{ThemeResource PanelBackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Layers" FontWeight="SemiBold" FontSize="12" />

                        <Border Grid.Row="1" Style="{StaticResource LayerActionPanelStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                                <Button x:Name="LayerPanelAddButton" Width="30" Style="{StaticResource LayerActionButtonStyle}" Click="LayerPanelAddButton_Click" ToolTipService.ToolTip="New layer">
                                    <FontIcon Glyph="&#xE710;" Style="{StaticResource LayerActionIconStyle}" />
                                </Button>

                                <Button x:Name="LayerDuplicateButton" Width="30" Style="{StaticResource LayerActionButtonStyle}" Click="LayerDuplicateButton_Click" ToolTipService.ToolTip="Duplicate layer">
                                    <FontIcon Glyph="&#xE8C8;" Style="{StaticResource LayerActionIconStyle}" />
                                </Button>

                                <Button x:Name="LayerDeleteButton" Width="30" Style="{StaticResource LayerActionDeleteButtonStyle}" Click="LayerDeleteButton_Click" ToolTipService.ToolTip="Delete layer">
                                    <FontIcon Glyph="&#xE74D;" Style="{StaticResource LayerActionIconStyle}" />
                                </Button>

                                <Rectangle Width="1" Height="18" Margin="4,0" VerticalAlignment="Center" Fill="{ThemeResource PanelStrokeBrush}" />

                                <Button x:Name="LayerMoveUpButton" Width="30" Style="{StaticResource LayerActionButtonStyle}" Click="LayerMoveUpButton_Click" ToolTipService.ToolTip="Move up">
                                    <FontIcon Glyph="&#xE70E;" Style="{StaticResource LayerActionIconStyle}" />
                                </Button>

                                <Button x:Name="LayerMoveDownButton" Width="30" Style="{StaticResource LayerActionButtonStyle}" Click="LayerMoveDownButton_Click" ToolTipService.ToolTip="Move down">
                                    <FontIcon Glyph="&#xE70D;" Style="{StaticResource LayerActionIconStyle}" />
                                </Button>

                                <Button x:Name="LayerMergeDownButton" Width="30" Style="{StaticResource LayerActionButtonStyle}" Click="LayerMergeDownButton_Click" ToolTipService.ToolTip="Merge down">
                                    <FontIcon Glyph="&#xE81E;" Style="{StaticResource LayerActionIconStyle}" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <ListView
                                x:Name="LayersListView"
                                AllowDrop="True"
                                CanDragItems="True"
                                CanReorderItems="True"
                                DragItemsCompleted="LayersListView_DragItemsCompleted"
                                AutomationProperties.Name="Layers list"
                                SelectionMode="Extended"
                                SelectionChanged="LayersListView_SelectionChanged">
                                <ListView.Resources>
                                    <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="MinHeight" Value="36" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            CornerRadius="6"
                                            Padding="6,4"
                                            Background="{Binding RowBackgroundBrush}"
                                            BorderBrush="{Binding RowBorderBrush}"
                                            BorderThickness="{Binding RowBorderThickness}">
                                            <Grid ColumnSpacing="8" MinHeight="32" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <ToggleButton
                                                    x:Name="LayerVisibilityToggleButton"
                                                    Grid.Column="0"
                                                    Style="{StaticResource LayerRowToggleStyle}"
                                                    IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                    Checked="LayerVisibilityCheckBox_Changed"
                                                    Unchecked="LayerVisibilityCheckBox_Changed"
                                                    ToolTipService.ToolTip="{Binding VisibilityTooltip}">
                                                    <Grid Width="16" Height="16">
                                                        <FontIcon Glyph="&#xE890;" FontSize="14" />
                                                        <Line
                                                            X1="12"
                                                            Y1="3"
                                                            X2="5"
                                                            Y2="12"
                                                            Stroke="{Binding Foreground, ElementName=LayerVisibilityToggleButton}"
                                                            StrokeThickness="1.8"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round"
                                                            Visibility="{Binding VisibilitySlashVisibility}" />
                                                    </Grid>
                                                </ToggleButton>

                                                <ToggleButton
                                                    Grid.Column="1"
                                                    Style="{StaticResource LayerRowToggleStyle}"
                                                    IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                                    Checked="LayerLockCheckBox_Changed"
                                                    Unchecked="LayerLockCheckBox_Changed"
                                                    ToolTipService.ToolTip="{Binding LockTooltip}">
                                                    <FontIcon Glyph="{Binding LockGlyph}" />
                                                </ToggleButton>

                                                <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        Foreground="{ThemeResource PrimaryTextBrush}"
                                                        FontWeight="{Binding NameFontWeight}"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{Binding Name}" />
                                                    <TextBox
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Name, Mode=TwoWay}"
                                                        KeyDown="LayerNameTextBox_KeyDown"
                                                        LostFocus="LayerNameTextBox_LostFocus"
                                                        Visibility="{Binding NameEditorVisibility}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="LayersEmptyTextBlock"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Text="No layers. Click + to add one." />
                        </Grid>

                        <Border
                            Grid.Row="3"
                            Padding="8,6"
                            CornerRadius="6"
                            Background="{ThemeResource PanelHeaderBackgroundBrush}"
                            BorderBrush="{ThemeResource PanelStrokeBrush}"
                            BorderThickness="1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="Opacity"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource PrimaryTextBrush}" />
                                <Slider
                                    x:Name="LayerOpacitySlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    StepFrequency="1"
                                    ToolTipService.ToolTip="Layer opacity (0–100%)"
                                    Foreground="{ThemeResource ColorSwatchSelectedBorderBrush}"
                                    Background="{ThemeResource PanelStrokeBrush}"
                                    ValueChanged="LayerOpacitySlider_ValueChanged" />
                                <TextBlock
                                    x:Name="LayerOpacityValueTextBlock"
                                    Grid.Column="2"
                                    Text="100%"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource PrimaryTextBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Users">
                    <Grid
                        RowSpacing="8"
                        Padding="6"
                        Background="{ThemeResource PanelBackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Users" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Grid.Column="1" x:Name="OnlineUsersCountTextBlock" Text="0" FontSize="12" />
                        </Grid>

                        <Border Grid.Row="1" x:Name="HostControlsPanel" Padding="6" CornerRadius="6" Background="{ThemeResource PanelHeaderBackgroundBrush}" BorderBrush="{ThemeResource PanelStrokeBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Host Controls" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource PrimaryTextBrush}" />
                                <TextBlock x:Name="HostRoomAccessTextBlock" Text="Open" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="HostClearCanvasButton" Content="Clear" Click="HostClearCanvasButton_Click" FontSize="11" Padding="6,2" ToolTipService.ToolTip="Erase all strokes from canvas" />
                                    <Button Grid.Column="1" x:Name="HostLockRoomButton" Content="Lock" Click="HostLockRoomButton_Click" FontSize="11" Padding="6,2" ToolTipService.ToolTip="Block or allow new joins" />
                                </Grid>

                                <TextBlock Text="Banned" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="BannedUsersComboBox" PlaceholderText="No banned users" DisplayMemberPath="DisplayName" SelectionChanged="BannedUsersComboBox_SelectionChanged" FontSize="11" ToolTipService.ToolTip="Users blocked from rejoining" />
                                    <Button Grid.Column="1" x:Name="HostUnbanUserButton" Content="Unban" Click="HostUnbanUserButton_Click" FontSize="11" Padding="6,2" ToolTipService.ToolTip="Let selected user rejoin" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <ListView x:Name="OnlineUsersListView" AutomationProperties.Name="Online users list" SelectionChanged="OnlineUsersListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" />
                                                <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource WarningBadgeTextBrush}" VerticalAlignment="Center" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibilityConverter}}" ToolTipService.ToolTip="Room Owner" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" x:Name="UserActionsPanel" Visibility="{Binding CanModerate, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button x:Name="KickUserButton" Content="Kick" Click="KickUserButton_Click" Padding="6,2" FontSize="11" ToolTipService.ToolTip="Remove from room" />
                                                <Button x:Name="BanUserButton" Content="Ban" Click="BanUserButton_Click" Padding="6,2" FontSize="11" ToolTipService.ToolTip="Remove and block from rejoining" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="OnlineUsersEmptyTextBlock" Text="Waiting for others to join" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Chat">
                    <Grid
                        RowSpacing="8"
                        Padding="6"
                        Background="{ThemeResource PanelBackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <ListView x:Name="ChatListView" AutomationProperties.Name="Group chat messages" SelectionMode="None">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection />
                                </ListView.ItemContainerTransitions>
                            </ListView>
                            <TextBlock x:Name="ChatEmptyTextBlock" Text="No messages yet" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False" FontSize="11" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInputTextBox" PlaceholderText="Type message..." KeyDown="ChatInputTextBox_KeyDown" AutomationProperties.Name="Chat message input" FontSize="11" />
                            <Button Grid.Column="1" x:Name="SendChatButton" Content="Send" Click="SendChatButton_Click" FontSize="11" Padding="12,4" ToolTipService.ToolTip="Send message (Enter)" />
                        </Grid>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Border>
    </Grid>
</Window>
