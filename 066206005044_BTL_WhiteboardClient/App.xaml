<Application
    x:Class="Btl.Whiteboard.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Btl.Whiteboard.Client">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F7FB" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FCFDFF" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#DDE5F0" />
                    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#EEF3FA" />
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CanvasGuideBrush" Color="#5A7090" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B2B40" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A6D87" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#7487A1" />
                    <SolidColorBrush x:Key="ColorSwatchSelectedBorderBrush" Color="#1F6FEB" />
                    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E9F1FC" />
                    <SolidColorBrush x:Key="BadgeTextBrush" Color="#23415F" />
                    <SolidColorBrush x:Key="PositiveBadgeBackgroundBrush" Color="#DAF4E2" />
                    <SolidColorBrush x:Key="PositiveBadgeTextBrush" Color="#0E5B2F" />
                    <SolidColorBrush x:Key="WarningBadgeBackgroundBrush" Color="#FFF1D9" />
                    <SolidColorBrush x:Key="WarningBadgeTextBrush" Color="#7A4B00" />
                    <SolidColorBrush x:Key="ErrorBadgeBackgroundBrush" Color="#FDE4E4" />
                    <SolidColorBrush x:Key="ErrorBadgeTextBrush" Color="#8A1212" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F7FB" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FCFDFF" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#DDE5F0" />
                    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#EEF3FA" />
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CanvasGuideBrush" Color="#5A7090" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B2B40" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A6D87" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#7487A1" />
                    <SolidColorBrush x:Key="ColorSwatchSelectedBorderBrush" Color="#1F6FEB" />
                    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E9F1FC" />
                    <SolidColorBrush x:Key="BadgeTextBrush" Color="#23415F" />
                    <SolidColorBrush x:Key="PositiveBadgeBackgroundBrush" Color="#DAF4E2" />
                    <SolidColorBrush x:Key="PositiveBadgeTextBrush" Color="#0E5B2F" />
                    <SolidColorBrush x:Key="WarningBadgeBackgroundBrush" Color="#FFF1D9" />
                    <SolidColorBrush x:Key="WarningBadgeTextBrush" Color="#7A4B00" />
                    <SolidColorBrush x:Key="ErrorBadgeBackgroundBrush" Color="#FDE4E4" />
                    <SolidColorBrush x:Key="ErrorBadgeTextBrush" Color="#8A1212" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#11161E" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A2230" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#2A3A4E" />
                    <SolidColorBrush x:Key="PanelHeaderBackgroundBrush" Color="#243146" />
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#0E1420" />
                    <SolidColorBrush x:Key="CanvasGuideBrush" Color="#A4B8D4" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F7FF" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAB9CD" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#8FA3BE" />
                    <SolidColorBrush x:Key="ColorSwatchSelectedBorderBrush" Color="#8FA3BE" />
                    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#293B56" />
                    <SolidColorBrush x:Key="BadgeTextBrush" Color="#D7E7FF" />
                    <SolidColorBrush x:Key="PositiveBadgeBackgroundBrush" Color="#214735" />
                    <SolidColorBrush x:Key="PositiveBadgeTextBrush" Color="#CCF3DE" />
                    <SolidColorBrush x:Key="WarningBadgeBackgroundBrush" Color="#5A3A1A" />
                    <SolidColorBrush x:Key="WarningBadgeTextBrush" Color="#FFE6C4" />
                    <SolidColorBrush x:Key="ErrorBadgeBackgroundBrush" Color="#5E2328" />
                    <SolidColorBrush x:Key="ErrorBadgeTextBrush" Color="#FFDCE1" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <local:InverseBoolConverter x:Key="InverseBoolConverter" />

            <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LayerActionPanelStyle" TargetType="Border">
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="LayerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="LayerActionDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource LayerActionButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource ErrorBadgeTextBrush}" />
            </Style>

            <Style x:Key="LayerActionLabelStyle" TargetType="TextBlock">
                <Setter Property="Style" Value="{StaticResource CaptionTextBlockStyle}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>

            <Style x:Key="LayerActionIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="LayerRowToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>

            <Style x:Key="LayerRowNameTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
